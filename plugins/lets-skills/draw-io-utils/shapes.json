      "groupStylePrefix": "points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;",
      "containers": {
        "aws_cloud": { "label": "AWS Cloud", "note": "strokeColor and fontColor were AWS Squid Ink #232F3E. Black instead: this outermost container has no brand boundary colour of its own, unlike region, VPC or account, so it takes the default black border and label.", "suffix": "grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#000000;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#000000;dashed=0;" },
        "region": { "label": "Region", "suffix": "grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" },
        "vpc": { "label": "VPC", "note": "fontColor was AWS's official label grey #AAB7B8, which is 2.06:1 on white and fails the validator's 3:1 font-contrast minimum. Changed to AWS's own VPC purple #8C4FFF, already this container's strokeColor, at 4.49:1.", "suffix": "grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" },
        "private_subnet": { "label": "Private subnet", "suffix": "grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" },
        "public_subnet": { "label": "Public subnet", "suffix": "grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" },
        "account": { "label": "AWS Account", "suffix": "grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" },
        "corporate_data_center": { "label": "Corporate data center", "suffix": "grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" },
        "ec2_instance_contents": { "label": "EC2 instance contents", "suffix": "grIcon=mxgraph.aws4.group_ec2_instance_contents;strokeColor=#D86613;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D86613;dashed=0;" },
        "auto_scaling_group": {
